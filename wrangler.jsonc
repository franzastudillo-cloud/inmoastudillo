{
  "name": "inmoastudillo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "inmo_db", "database_id": "44e4e253-0d09-46d6-8b96-40be027a9172" }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "inmo-fotos" }
  ]
}
